HOST=127.0.0.1
PORT=9090
# Local .NET HTTP profiles
INVENTORY_API_URL=http://localhost:5041
IDENTITY_API_URL=http://localhost:5042
ORDERS_API_URL=http://localhost:5045
REPORTING_API_URL=http://localhost:5046
# Supply the same private signing key to Identity via Jwt__SecretKey.
JWT_SECRET_KEY=
JWT_ISSUER=StockSync.Identity
JWT_AUDIENCE=StockSync.Ecosystem
UPSTREAM_TIMEOUT_MS=10000
# Only this verified tenant can use Orders and purchase order routes.
TENANT_ID=00000000-0000-0000-0000-000000000001
# Optional custom CA for an HTTPS backend:
# INVENTORY_CA_FILE=./certs/inventory.pem
