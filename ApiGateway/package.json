{
  "name": "stocksync-api-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StockSync API gateway with NestJS and TypeScript",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --use-system-ca --env-file-if-exists=.env dist/main.js",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --use-system-ca --env-file-if-exists=.env dist/main.js\""
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.6.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  }
}
