HOST=127.0.0.1
PORT=9090
# Inventory in Docker; use http://localhost:5041 for dotnet run.
INVENTORY_API_URL=http://localhost:5001
# Identity in Docker; use http://localhost:5042 for dotnet run.
IDENTITY_API_URL=http://localhost:5002
# Orders in Docker; use http://localhost:5045 for dotnet run.
ORDERS_API_URL=http://localhost:5003
# Reporting in Docker; use http://localhost:5046 for dotnet run.
REPORTING_API_URL=http://localhost:5004
# Notification in Docker; use http://localhost:5047 for dotnet run.
NOTIFICATION_API_URL=http://localhost:5005
UPSTREAM_TIMEOUT_MS=10000
# Fixed Orders tenant and fallback for Inventory and Reporting.
TENANT_ID=00000000-0000-0000-0000-000000000001
# Optional custom CA for an HTTPS backend:
# INVENTORY_CA_FILE=./certs/inventory.pem
