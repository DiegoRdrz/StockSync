HOST=127.0.0.1
PORT=9090
# API en Docker. Para dotnet run cambia a http://localhost:5041.
INVENTORY_API_URL=http://localhost:5001
UPSTREAM_TIMEOUT_MS=10000
# Tenant fijo para desarrollo; no proviene del cliente.
TENANT_ID=00000000-0000-0000-0000-000000000001
# Solo para un backend HTTPS con CA propia:
# INVENTORY_CA_FILE=./certs/inventario.pem
