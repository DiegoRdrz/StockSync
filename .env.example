# Copy to .env (ignored by Git) to override Docker Compose defaults.
POSTGRES_PASSWORD=stock1234
LOAD_DEMO_DATA=false

# RabbitMQ credentials used by the broker and the orders service.
RABBITMQ_USER=stocksync
RABBITMQ_PASSWORD=stocksync

# API Gateway
GATEWAY_PORT=9090
GATEWAY_TENANT_ID=00000000-0000-0000-0000-000000000001

# Provision the same random secret to Identity and the gateway (at least 32 UTF-8 bytes).
JWT_SECRET_KEY=
JWT_ISSUER=StockSync.Identity
JWT_AUDIENCE=StockSync.Ecosystem
