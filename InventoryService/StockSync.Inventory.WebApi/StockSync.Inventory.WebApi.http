@StockSync.Inventory.WebApi_HostAddress = http://localhost:5041

### Latest 10 movements (use port 5001 for Docker)
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/movements

### Next page of 10 movements
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/movements/page/2

### 1. Create a category
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Tools",
  "description": "General-purpose tools"
}

> {%
    client.global.set("category_id", response.body.id);
%}

### 2. Create a product in the category
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Hammer",
  "sku": "HER-001",
  "description": "Steel hammer",
  "purchasePrice": 10.50,
  "salePrice": 15.00,
  "minimumStock": 5,
  "categoryId": "{{category_id}}"
}

> {%
    client.global.set("product_id", response.body.id);
%}

### 3. List products in the category
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/categories/{{category_id}}/products

### 4. Reject category deletion with active products (409)
DELETE {{StockSync.Inventory.WebApi_HostAddress}}/api/categories/{{category_id}}

### 5. Reject a duplicate category name (409)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": " tools ",
  "description": "Duplicate"
}

### 6. Reject an invalid category reference (400)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Drill",
  "sku": "HER-002",
  "description": "Drill",
  "purchasePrice": 50.00,
  "salePrice": 75.00,
  "minimumStock": 2,
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

### 7. Assign a product to a branch with zero initial stock
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock
Content-Type: application/json

{
  "productId": "{{product_id}}",
  "branchId": "11111111-1111-1111-1111-111111111111",
  "quantity": 0
}

> {%
    client.global.set("stock_id", response.body.id);
%}

### 8. Receive 10 units (201, balance 10)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/receipts
Content-Type: application/json

{ "quantity": 10 }

### 9. Issue 3 units (201, balance 7)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/issues
Content-Type: application/json

{ "quantity": 3 }

### 10. Reject an issue of 8 units (409, balance stays 7)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/issues
Content-Type: application/json

{ "quantity": 8 }

### 11. Issue the remaining 7 units (201, balance 0)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/issues
Content-Type: application/json

{ "quantity": 7 }

### 12. Reject an issue with no stock (409)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/issues
Content-Type: application/json

{ "quantity": 1 }

### 13. Reject an invalid quantity (400)
POST {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/receipts
Content-Type: application/json

{ "quantity": 0 }

### 14. Read history (three successful movements)
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}/movements?page=1&pageSize=20

### 15. Read the final balance (0)
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}

### 16. Reject assignment deletion because history exists (409)
DELETE {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}

### 17. Low stock: zero balance, minimum 5, shortage 5
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/low-stock?branchId=11111111-1111-1111-1111-111111111111

### 18. Adjust to 15 units (200, adjustment recorded in history)
PUT {{StockSync.Inventory.WebApi_HostAddress}}/api/stock/{{stock_id}}
Content-Type: application/json

{ "newQuantity": 15 }

### 19. Reject deactivation of a product with stock (409)
DELETE {{StockSync.Inventory.WebApi_HostAddress}}/api/products/{{product_id}}

### 20. Another tenant cannot see the previous data (empty items)
GET {{StockSync.Inventory.WebApi_HostAddress}}/api/products
X-Tenant-Id: 3f2b8c1e-5d4a-4e6f-9a7b-1c2d3e4f5a6b
