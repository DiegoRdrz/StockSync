{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StockSync.Identity",
    "Audience": "StockSync.Ecosystem",
    "SecretKey": "StockSyncSuperSecretSecureKey123456789!NeverShareInProduction!"
  },
  "Multitenancy": {
    "RequireHeader": true
  },
  "Inventory": {
    "TimeoutSeconds": 10
  },
  "RabbitMq": {
    "Exchange": "stocksync.events"
  }
}
